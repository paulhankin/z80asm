    db 0x01, 23, 1 ; dw spr_clock_0, 0 ; db 2, 2, 6, 6   // 16 clock
    db 0x01, 24, 1 ; dw spr_cradle_0, 0 ; db 1, 2, 7, 6   // 17 cradle
    db 0x01, 25, 1 ; dw spr_desk_0, 0 ; db 0, 1, 8, 7   // 18 desk
