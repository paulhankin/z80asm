    db 0x00, 0x66, 0x76, 0x7e, 0x6e, 0x66, 0x66, 0x00
    db 0x00, 0x3c, 0x66, 0x66, 0x66, 0x66, 0x3c, 0x00
    db 0x00, 0x7c, 0x66, 0x66, 0x7c, 0x60, 0x60, 0x00
    db 0x00, 0x3c, 0x66, 0x66, 0x6e, 0x6c, 0x36, 0x00
    db 0x00, 0x7c, 0x66, 0x66, 0x7c, 0x6c, 0x66, 0x00
    db 0x00, 0x3c, 0x60, 0x3c, 0x06, 0x66, 0x3c, 0x00
