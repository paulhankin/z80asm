// Hollowmere: a quiet game of exploration for the 48K ZX Spectrum.
//
// Assemble with:   go run ./cmd/z80asm examples/hollowmere/hollowmere.z80
// which writes examples/hollowmere/hollowmere.sna.
//
// You wander the empty rooms of a castle, seen in isometric 3D. There is
// no combat and nothing can hurt you. Eight things that were once loved
// are hidden in the castle; find them all and ring the bell in the tower.
//
// Keys:
//   Q / 7     north (up and to the right)
//   A / 6     south (down and to the left)
//   O / 5     west  (up and to the left)
//   P / 8     east  (down and to the right)
//   SPACE / ENTER   look at whatever is next to you
//   M         map of the floor you are on
//
// The game doesn't use the ROM. It has its own font and keyboard reading,
// and an IM 2 interrupt handler for timing.
//
// Drawing
// -------
// The world is drawn back to front into a small scratch buffer, one
// rectangle of the screen at a time, and then copied to the screen. The
// background (walls, floor tiles, the front edges of the floor) is a list
// of pieces made when entering a room; the objects in the room, the
// player and the ghost are sorted by depth each frame. Only the parts of
// the screen that change are redrawn.
//
// All sprites are stored as (mask, data) byte pairs: the screen byte
// becomes (screen AND mask) OR data. The player and the ghost move
// smoothly, off the tile grid, so their sprites are shifted (and mirrored
// for the left-facing directions) before drawing. Everything else sits on
// the tile grid, which is byte aligned. The ghost's mask lets everything
// behind her show through.
//
// World coordinates
// -----------------
// A floor tile is 8x8 units. Positions are biased by 16 so that doorways
// (which stick out of the room) stay positive: the floor of a room covers
// 16 <= x < 16 + 8*W, 16 <= y < 16 + 8*D. A point (x, y) is drawn at
//     screen x = CX + 2*(x - y)
//     screen y = CY - 32 + x + y
// where CX, CY centre the room on the screen.

// ---- BEGIN GENERATED CONSTS (gen.py) ----
// Object types.
const T_PILLAR = 1
const T_BLOCK = 2
const T_MERLON = 3
const T_TABLE = 4
const T_CHAIR = 5
const T_BED = 6
const T_COFFIN = 7
const T_BOOKCASE = 8
const T_BARREL = 9
const T_THRONE = 10
const T_PEW = 11
const T_ALTAR = 12
const T_WELL = 13
const T_CHEST = 14
const T_BELL = 15
const T_CLOCK = 16
const T_CRADLE = 17
const T_DESK = 18
const T_CAULDRON = 19
const T_CARPET = 20
const T_STAIRSUP = 21
const T_STAIRSDOWN = 22
const T_GATE_NS = 23
const T_GATE_WE = 24
const T_ARMOUR = 25
const T_CANDELABRA = 26
const T_CANDLE = 27
const T_URN = 28
const T_GRAVE = 29
const T_TREE = 30
const T_STATUE = 31
const T_MIRROR = 32
const T_BONES = 33
const T_ROCKER = 34
const T_ITEM = 35
const NTYPES = 35
const NROOMS = 91
const START_ROOM = 56
const BELFRY = 83
const NITEMS = 11
const WALL_H = 40
const W_PLAIN = 0
const W_ARCH = 1
const W_WINDOW = 2
const W_MOON = 3
const W_PORTRAIT = 4
const W_TORCH = 5
const W_BANNER = 6
const W_SHIELD = 7
const W_WEB = 8
const W_HEARTH = 9
const W_CRACK = 10
const PLAYER_ROWS = 26
const NAMBIENT = 16
const NGHOSTTXT = 4
const NNOTHING = 4
const TX_NOTHING = 52
const TX_AMBIENT = 56
const TX_GHOST = 72
const TX_LOCKED1 = 76
const TX_LOCKED2 = 77
const TX_LOCKED3 = 78
const TX_UNLOCK1 = 79
const TX_UNLOCK2 = 80
const TX_UNLOCK3 = 81
const TX_SEALED = 82
const TX_UNSEAL = 83
const TX_BELFRY = 84
const TX_ALLMEM = 85
const TX_STAIRUP = 86
const TX_STAIRDOWN = 87
const TX_COUNT = 88
const TX_KEY0 = 89
const TX_KEY1 = 90
const TX_KEY2 = 91
const NENDING = 4
// ---- END GENERATED CONSTS ----

// Memory: the program is at 0x5b00 upwards; these buffers go above it.
const PCACHE = 0xe000       // the player's sprites, shifted (12 slots)
const PSLOT = 4 + 8 * PLAYER_ROWS
const SCRATCH = 0xed00      // the drawing buffer
const SCRATCH_SIZE = 2048
const REVTAB = 0xf500       // bit-reversed bytes, for mirroring
const OBJS = 0xf600         // the objects in the room (32 x 16 bytes)
const BGLIST = 0xf800       // background pieces (up to 96 x 7 bytes)
const DLIST = 0xfab0        // object numbers, in drawing order
const GBUF = 0xfbc0         // the ghost's sprite, shifted
const STACK = 0xfdfc        // the stack grows down from here
                            // (0xfdfd-0xff00: the interrupt vector table)

const PF_ROWS = 168         // pixel rows of the playing area
const MAXOBJ = 32
const MAXBG = 96

// An object in the room (16 bytes).
const O_TYPE = 0            // object type (0 = gone)
const O_FLAGS = 1           // F_ flags from its type
const O_EXTRA = 2           // item number, lock, stair target; bit 7 = anim frame
const O_X = 3               // position of its tile (world units)
const O_Y = 4
const O_SPR = 5             // sprite
const O_SPRH = 6
const O_COL = 7             // where it is drawn: byte column, pixel row
const O_ROW = 8
const O_W = 9               // sprite size: bytes, rows
const O_H = 10
const O_KEY = 11            // depth: larger is nearer
const O_BX0 = 12            // collision box (world units)
const O_BY0 = 13
const O_BX1 = 14
const O_BY1 = 15

// Object type flags.
const F_SOLID = 0x01
const F_FLAT = 0x02
const F_ITEM = 0x04
const F_ANIM = 0x08
const F_UP = 0x10
const F_DOWN = 0x20
const F_GATE = 0x40
const F_BELL = 0x80

// The type table: 11 bytes per type.
const TT_FLAGS = 0
const TT_TEXT = 1
const TT_NTEXT = 2
const TT_SPR = 3
const TT_SPR2 = 5
const TT_BOX = 7
const TT_SIZE = 11

// Pseudo types for the player and the ghost.
const T_PLAYER = 0xff
const T_GHOST = 0xfe

// Input bits.
const K_N = 0x01
const K_S = 0x02
const K_W = 0x04
const K_E = 0x08
const K_LOOK = 0x10
const K_MAP = 0x20

// Directions the player can face (and which sprite to use).
const D_E = 0               // front
const D_S = 1               // front, mirrored
const D_N = 2               // back
const D_W = 3               // back, mirrored

// How the player arrives in a room.
const ARRIVE_S = 0          // through the south doorway (having gone north)
const ARRIVE_W = 1
const ARRIVE_N = 2
const ARRIVE_E = 3
const ARRIVE_STAIRS = 4
const ARRIVE_START = 5

// Colours.
const ATTR_NAME = 0x46
const ATTR_MSG = 0x07
const ATTR_PANEL = 0x07
const ATTR_HEAD = 0x46

const MSG_TIME = 350        // frames a message stays up

// The graphics, rooms and text go first, in the lower 16K of RAM (which
// the display slows down); the code goes above them.
org 0x5b00

// ---- BEGIN GENERATED DATA (gen.py) ----
// Object types: flags, first text, number of texts, sprite,
// second animation frame (or 0), collision box x0, y0, x1, y1.
types:
    db 0x01, 0, 2 ; dw spr_pillar_0, 0 ; db 1, 1, 7, 7   // 1 pillar
    db 0x01, 2, 1 ; dw spr_block_0, 0 ; db 0, 0, 8, 8   // 2 block
    db 0x01, 3, 1 ; dw spr_merlon_0, 0 ; db 0, 0, 8, 8   // 3 merlon
    db 0x01, 4, 2 ; dw spr_table_0, 0 ; db 0, 0, 8, 8   // 4 table
    db 0x01, 6, 1 ; dw spr_chair_0, 0 ; db 2, 2, 6, 6   // 5 chair
    db 0x01, 7, 2 ; dw spr_bed_0, 0 ; db 0, 0, 8, 16   // 6 bed
    db 0x01, 9, 2 ; dw spr_coffin_0, 0 ; db 1, 0, 7, 16   // 7 coffin
    db 0x01, 11, 3 ; dw spr_bookcase_0, 0 ; db 0, 0, 8, 4   // 8 bookcase
    db 0x01, 14, 1 ; dw spr_barrel_0, 0 ; db 1, 1, 7, 7   // 9 barrel
    db 0x01, 15, 1 ; dw spr_throne_0, 0 ; db 1, 1, 7, 7   // 10 throne
