    db 0x00, 0x00, 0x60, 0x9f, 0x65, 0x00, 0x00, 0x00
    db 0x10, 0x30, 0x38, 0x7c, 0x6c, 0x38, 0x00, 0x00
    db 0x10, 0x38, 0x7c, 0xfe, 0x7c, 0x38, 0x10, 0x00
    db 0x00, 0x3c, 0x66, 0x0c, 0x18, 0x00, 0x18, 0x00
