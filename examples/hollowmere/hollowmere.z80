    db 0x00, 0x00, 0x00, 0x00, 0x7e, 0x00, 0x00, 0x00
    db 0x00, 0x00, 0x00, 0x00, 0x00, 0x18, 0x18, 0x00
    db 0x00, 0x06, 0x0c, 0x18, 0x30, 0x60, 0x00, 0x00
    db 0x00, 0x3c, 0x66, 0x6e, 0x76, 0x66, 0x3c, 0x00
    db 0x00, 0x18, 0x38, 0x18, 0x18, 0x18, 0x7e, 0x00
    db 0x00, 0x3c, 0x66, 0x0c, 0x18, 0x30, 0x7e, 0x00
    db 0x00, 0x3c, 0x66, 0x0c, 0x06, 0x66, 0x3c, 0x00
    db 0x00, 0x0c, 0x1c, 0x3c, 0x6c, 0x7e, 0x0c, 0x00
    db 0x00, 0x7e, 0x60, 0x7c, 0x06, 0x66, 0x3c, 0x00
