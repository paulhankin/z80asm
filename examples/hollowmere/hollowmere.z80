text_0: ds "SOMEONE HAS SCRATCHED A TALLY OF|DAYS INTO THE STONE." ; db 0
text_1: ds "A PILLAR, WORN SMOOTH WHERE|HANDS HAVE LEANED." ; db 0
text_2: ds "A BLOCK OF GREY STONE, COLD TO|THE TOUCH." ; db 0
text_3: ds "BEYOND THE PARAPET, ONLY FOG. NO|LAND, NO SKY." ; db 0
text_4: ds "THE TABLE IS SET FOR TWO.|NEITHER PLACE HAS BEEN USED." ; db 0
text_5: ds "DUST, AND IN THE DUST A FINGER|HAS WRITTEN: WAIT." ; db 0
text_6: ds "A CHAIR, PULLED OUT, AS IF|SOMEONE HAS JUST STOOD UP." ; db 0
text_7: ds "THE BED IS MADE. THE PILLOW|STILL HOLDS THE SHAPE OF A HEAD." ; db 0
text_8: ds "THE SHEETS ARE COLD AND SMELL OF|LAVENDER." ; db 0
text_9: ds "THE LID IS AJAR. YOU DO NOT LOOK|INSIDE." ; db 0
text_10: ds "A STONE COFFIN. THE NAME HAS|BEEN CHISELLED AWAY." ; db 0
text_11: ds "EVERY BOOK HERE HAS THE SAME|TITLE: THE LONG WAIT." ; db 0
text_12: ds "A BOOK OF NAMES. THE LAST PAGE|HAS BEEN TORN OUT." ; db 0
text_13: ds "ONE BOOK IS MARKED, AT A PAGE|ABOUT A RIVER IN WINTER." ; db 0
text_14: ds "EMPTY. IT SMELLS OF OLD WINE." ; db 0
text_15: ds "THE THRONE IS THICK WITH DUST,|EXCEPT FOR THE SEAT." ; db 0
text_16: ds "A PRAYER BOOK LIES OPEN AT THE|SERVICE FOR THE DEAD." ; db 0
text_17: ds "THE CANDLES ON THE ALTAR ARE|NEW. NO ONE HAS LIT THEM." ; db 0
text_18: ds "YOU DROP A PEBBLE IN. YOU NEVER|HEAR IT LAND." ; db 0
text_19: ds "FAR BELOW, SOMETHING GLINTS. OR|BLINKS." ; db 0
text_20: ds "THE CHEST IS FULL OF CHILDREN'S|CLOTHES, NEATLY FOLDED." ; db 0
text_21: ds "BLANKETS, AND THE SMELL OF|CEDAR." ; db 0
text_22: ds "THE GREAT BELL. IT IS STILL|SWINGING, VERY SLIGHTLY." ; db 0
text_23: ds "THE CLOCK HAS STOPPED AT A|QUARTER TO THREE." ; db 0
text_24: ds "THE CRADLE ROCKS GENTLY. THERE|IS NO DRAUGHT." ; db 0
text_25: ds "A DIARY. THE LAST ENTRY SAYS|ONLY: STILL NO WORD." ; db 0
text_26: ds "THE POT IS COLD. SOMETHING WAS|COOKED HERE, LONG AGO." ; db 0
text_27: ds "AN EMPTY SUIT OF ARMOUR. THE|VISOR IS DOWN." ; db 0
text_28: ds "THE HELMET IS TURNED TOWARDS|YOU. WAS IT BEFORE?" ; db 0
text_29: ds "THE CANDLES BURN, THOUGH NO ONE|HAS LIT THEM." ; db 0
text_30: ds "A CANDLE. THE WAX IS STILL SOFT|AND WARM." ; db 0
text_31: ds "ASHES. A NAME IS SCRATCHED ON|THE LID, TOO FAINT TO READ." ; db 0
text_32: ds "HERE LIES... THE REST IS COVERED|IN MOSS." ; db 0
text_33: ds "A NEW STONE, WITH NO NAME ON IT|YET." ; db 0
text_34: ds "BELOVED. ALWAYS. THE DATE HAS|WORN AWAY." ; db 0
text_35: ds "A DEAD TREE. TWO INITIALS ARE|CARVED IN THE BARK." ; db 0
text_36: ds "A STONE ANGEL, WEEPING INTO ITS|HANDS." ; db 0
text_37: ds "THE MIRROR SHOWS THE ROOM BEHIND|YOU. IT DOES NOT SHOW YOU." ; db 0
text_38: ds "BONES, NEATLY STACKED. SOMEONE|CARED FOR THEM." ; db 0
text_39: ds "A ROCKING HORSE. IT IS STILL|MOVING, VERY SLIGHTLY." ; db 0
text_40: ds "OUTSIDE, FOG. THE MOON HAS NOT|MOVED ALL NIGHT." ; db 0
text_41: ds "YOUR BREATH MISTS THE GLASS.|SOMETHING WRITES IN IT." ; db 0
text_42: ds "A FULL MOON, WHITE AND VERY|STILL." ; db 0
text_43: ds "A WOMAN IN GREY. SHE LOOKS AS IF|SHE IS LISTENING." ; db 0
text_44: ds "A MAN IN BLACK. HIS EYES HAVE|BEEN PAINTED CLOSED." ; db 0
text_45: ds "A CHILD WITH A LANTERN. THE FACE|IS FAMILIAR." ; db 0
text_46: ds "THE FLAME DOES NOT FLICKER. IT|GIVES NO WARMTH." ; db 0
text_47: ds "A BANNER: A SWAN ABOVE A BROKEN|KEY." ; db 0
text_48: ds "AN OLD SHIELD. THE MOTTO READS:|WE WAIT." ; db 0
text_49: ds "A COBWEB. THE SPIDER IS LONG|GONE." ; db 0
text_50: ds "THE ASHES IN THE HEARTH ARE|STILL WARM." ; db 0
text_51: ds "A CRACK IN THE WALL. COLD AIR|BREATHES THROUGH IT." ; db 0
text_52: ds "THERE IS NOTHING HERE BUT DUST." ; db 0
text_53: ds "YOU HEAR ONLY YOUR OWN|BREATHING." ; db 0
text_54: ds "NOTHING. THE SILENCE PRESSES IN." ; db 0
text_55: ds "YOUR LANTERN'S LIGHT SHOWS|NOTHING NEW." ; db 0
text_56: ds "SOMEWHERE, A DOOR CLOSES." ; db 0
text_57: ds "FOOTSTEPS OVERHEAD. THEN|NOTHING." ; db 0
text_58: ds "A DRAUGHT, AND THE SMELL OF|ROSES." ; db 0
text_59: ds "YOU THINK YOU HEAR YOUR NAME." ; db 0
text_60: ds "A CLOCK STRIKES, FAR AWAY." ; db 0
text_61: ds "THE CASTLE SETTLES AND CREAKS." ; db 0
text_62: ds "SOMEONE IS HUMMING. IT STOPS." ; db 0
text_63: ds "WATER DRIPS SOMEWHERE IN THE|DARK." ; db 0
text_64: ds "A CHILD LAUGHS, SOMEWHERE BELOW." ; db 0
text_65: ds "THE AIR GROWS COLD, THEN WARM|AGAIN." ; db 0
text_66: ds "A WINDOW RATTLES IN ITS FRAME." ; db 0
text_67: ds "YOU FEEL YOU ARE BEING WATCHED." ; db 0
text_68: ds "A SOFT KNOCK. THEN SILENCE." ; db 0
text_69: ds "YOUR LANTERN DIMS, THEN|STEADIES." ; db 0
text_70: ds "SOMEWHERE, SOMEONE IS WAITING." ; db 0
text_71: ds "DUST FALLS FROM THE CEILING." ; db 0
text_72: ds "SHE IS GONE." ; db 0
text_73: ds "WAS SOMEONE THERE?" ; db 0
text_74: ds "A CHILL PASSES THROUGH YOU." ; db 0
text_75: ds "SHE FADES LIKE BREATH ON GLASS." ; db 0
text_76: ds "LOCKED. IT WILL NEED THE IRON|KEY." ; db 0
text_77: ds "LOCKED. IT WILL NEED THE BRASS|KEY." ; db 0
text_78: ds "LOCKED. IT WILL NEED THE SILVER|KEY." ; db 0
text_79: ds "THE IRON KEY TURNS. THE GATE|RISES." ; db 0
text_80: ds "THE BRASS KEY TURNS. THE GATE|RISES." ; db 0
text_81: ds "THE SILVER KEY TURNS. THE GATE|RISES." ; db 0
text_82: ds "THE DOOR WILL NOT OPEN. NOT YET.|NOT UNTIL YOU REMEMBER." ; db 0
text_83: ds "THE DOOR OPENS BY ITSELF." ; db 0
text_84: ds "THE BELL ROPE HANGS WITHIN|REACH." ; db 0
text_85: ds "SOMEWHERE HIGH ABOVE, A GREAT|BELL BEGINS TO SWING." ; db 0
text_86: ds "YOU CLIMB THE STAIRS." ; db 0
text_87: ds "YOU GO DOWN THE STAIRS." ; db 0
text_88: ds "OF 8 REMEMBERED" ; db 0
text_89: ds "AN IRON KEY, HEAVY AND COLD." ; db 0
text_90: ds "A BRASS KEY, WARM, AS IF SOMEONE|HAS JUST PUT IT DOWN." ; db 0
text_91: ds "A SILVER KEY. IT HUMS FAINTLY IN|YOUR HAND." ; db 0

item_names:
    dw iname_0, iname_1, iname_2, iname_3, iname_4, iname_5, iname_6, iname_7, iname_8, iname_9, iname_10
iname_0: ds "THE MUSIC BOX" ; db 0
iname_1: ds "THE LOCKET" ; db 0
iname_2: ds "THE LETTER" ; db 0
iname_3: ds "THE WOODEN HORSE" ; db 0
iname_4: ds "THE MIRROR SHARD" ; db 0
iname_5: ds "THE RING" ; db 0
iname_6: ds "THE ROSE" ; db 0
iname_7: ds "THE PAINTING" ; db 0
iname_8: ds "THE IRON KEY" ; db 0
iname_9: ds "THE BRASS KEY" ; db 0
iname_10: ds "THE SILVER KEY" ; db 0
memory_texts:
    dw mtext_0, mtext_1, mtext_2, mtext_3, mtext_4, mtext_5, mtext_6, mtext_7
mtext_0: ds "A MUSIC BOX. YOU TURN THE|KEY AND IT PLAYS THREE|NOTES, THEN STOPS. SOMEONE|USED TO HUM THE REST OF|THE TUNE. YOU FIND THAT|YOU CAN, TOO." ; db 0
mtext_1: ds "A SILVER LOCKET. INSIDE|ARE TWO TINY PORTRAITS: A|WOMAN IN GREY, AND A|CHILD. THE CHILD HAS YOUR|EYES." ; db 0
mtext_2: ds "A LETTER, NEVER SENT: 'THE|HOUSE IS SO QUIET. I LEAVE|A CANDLE IN THE WINDOW|EVERY NIGHT, SO THAT YOU|CAN FIND YOUR WAY HOME.'" ; db 0
mtext_3: ds "A WOODEN HORSE, WORN|SMOOTH BY SMALL HANDS. YOU|KNOW ITS NAME. YOU GAVE IT|ONE, LONG AGO." ; db 0
mtext_4: ds "A SHARD OF MIRROR. IN IT|YOU SEE THE ROOM, THE|CANDLES, THE DUST. YOU|TILT IT, LOOKING FOR|YOURSELF. YOU ARE NOT|THERE." ; db 0
mtext_5: ds "A WEDDING RING, ENGRAVED|'ALWAYS'. IT WAS LEFT ON A|TOMB, AS IF SOMEONE COULD|NOT BEAR TO WEAR IT ANY|MORE." ; db 0
mtext_6: ds "A DRIED ROSE, PRESSED|FLAT. SOMEONE PICKED IT|FOR A GRAVE, AND THEN|COULD NOT LET IT GO." ; db 0
mtext_7: ds "A SMALL PAINTING OF A|FAMILY ON THE CASTLE|STAIRS: A MAN, A WOMAN IN|GREY, AND A CHILD WITH A|LANTERN. THE PAINT OF THE|CHILD IS NEWER, AS IF IT|WAS ADDED LATER." ; db 0
intro_text: ds "THE GATES OF HOLLOWMERE|STAND OPEN. NO ONE ANSWERS|WHEN YOU CALL.||YOU DO NOT REMEMBER HOW|YOU CAME HERE, ONLY THAT|YOU WERE MEANT TO.||SOMEWHERE IN THESE EMPTY|HALLS ARE EIGHT THINGS|THAT WERE ONCE LOVED. FIND|THEM, AND PERHAPS YOU WILL|REMEMBER." ; db 0
ending_texts:
    dw etext_0, etext_1, etext_2, etext_3
etext_0: ds "YOU TAKE THE ROPE AND|PULL. THE GREAT BELL|SPEAKS, ONCE, AND THE|WHOLE CASTLE SEEMS TO|LISTEN." ; db 0
etext_1: ds "FROM THE BELFRY WINDOW YOU|SEE A LIGHT IN THE|GATEHOUSE, AND A WOMAN IN|GREY, HOLDING A CANDLE.|SHE HAS BEEN WAITING FOR A|VERY LONG TIME." ; db 0
etext_2: ds "YOU REMEMBER NOW. THE|RIVER, THE COLD, THE|LANTERN GOING OUT. YOU|WERE NEVER LOST. YOU WERE|ONLY LATE." ; db 0
etext_3: ds "YOU GO DOWN TO MEET HER.||AND HOLLOWMERE, AT LAST,|IS QUIET.||THE END" ; db 0
floor_names:
    dw fname_0, fname_1, fname_2, fname_3
fname_0: ds "THE CRYPTS" ; db 0
fname_1: ds "THE GROUND FLOOR" ; db 0
fname_2: ds "THE UPPER FLOOR" ; db 0
fname_3: ds "THE TOWER" ; db 0

// Font: characters 32 to 90, 8 bytes each.
font:
    db 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00
    db 0x00, 0x18, 0x18, 0x18, 0x18, 0x00, 0x18, 0x00
    db 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00
    db 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00
    db 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00
    db 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00
    db 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00
    db 0x00, 0x18, 0x18, 0x30, 0x00, 0x00, 0x00, 0x00
