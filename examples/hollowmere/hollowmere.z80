    db 0x09, 29, 1 ; dw spr_candelabra_0, spr_candelabra_1 ; db 3, 3, 5, 5   // 26 candelabra
    db 0x09, 30, 1 ; dw spr_candle_0, spr_candle_1 ; db 3, 3, 5, 5   // 27 candle
    db 0x01, 31, 1 ; dw spr_urn_0, 0 ; db 2, 2, 6, 6   // 28 urn
    db 0x01, 32, 3 ; dw spr_grave_0, 0 ; db 1, 3, 7, 5   // 29 grave
    db 0x01, 35, 1 ; dw spr_tree_0, 0 ; db 2, 2, 6, 6   // 30 tree
    db 0x01, 36, 1 ; dw spr_statue_0, 0 ; db 2, 2, 6, 6   // 31 statue
